VITE_API_URL=http://localhost:3001
VITE_SOCKET_URL=http://localhost:3001

# VITE_LIVEKIT_WS_URL - WebSocket URL for LiveKit connection (REQUIRED)
# LiveKit Cloud example: wss://your-project.livekit.cloud
# Self-hosted example: wss://your-livekit-domain.com or ws://your-livekit-ip:7880 (dev only)
# NOTE: Production MUST use wss:// (secure websocket)
VITE_LIVEKIT_WS_URL=wss://your-livekit-server.com
